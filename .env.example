# GymRat Docker & Cloudflare Tunnel Environment Configuration

# Host Port Mapping (e.g. 8080)
PORT=8080

# Target Domain Name
DOMAIN_NAME=gymrat.rufw.io

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard)
# TUNNEL_TOKEN=eyJhIjoi...

# Storage Paths inside container
SESSIONS_DIR=/app/data/sessions
WEB_DIR=/app/web

# Storage Mode: "memory" (default, 0 server disk writes) or "disk"
STORAGE_MODE=memory

# Max Upload Request Body Size in MB (default 5)
MAX_PAYLOAD_MB=5

# Server execution mode
SERVER_MODE=true


